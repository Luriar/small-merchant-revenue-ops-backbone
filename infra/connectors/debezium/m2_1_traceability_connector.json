{
  "name": "m2-1-traceability-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "${AURORA_HOST}",
    "database.port": "5432",
    "database.user": "${AURORA_DB_USER}",
    "database.password": "${AURORA_DB_PASSWORD}",
    "database.dbname": "productops",
    "topic.prefix": "aurora-productops-m2-1",
    "plugin.name": "pgoutput",
    "slot.name": "m2_1_traceability_slot",
    "publication.name": "m2_1_traceability_pub",
    "publication.autocreate.mode": "disabled",
    "schema.include.list": "public",
    "table.include.list": "public.prod_change,public.trace,public.issue",
    "column.include.list": "public.prod_change.change_id,public.prod_change.chgt_cd,public.prod_change.title,public.prod_change.target_service,public.prod_change.target_component,public.prod_change.variation,public.prod_change.cohort,public.prod_change.source,public.prod_change.occurred_at,public.prod_change.received_at,public.prod_change.created_at,public.prod_change.updated_at,public.trace.trace_id,public.trace.change_id,public.trace.primary_issue_id,public.trace.status,public.trace.confidence,public.trace.anomaly_window_start,public.trace.anomaly_window_end,public.trace.anomaly_type,public.trace.anomaly_metric,public.trace.anomaly_detail,public.trace.linked_event_count,public.trace.linked_issue_count,public.trace.evidence_count,public.trace.generated_by_run_id,public.trace.created_at,public.trace.updated_at,public.issue.issue_id,public.issue.external_id,public.issue.source,public.issue.issue_family,public.issue.severity,public.issue.status,public.issue.keywords,public.issue.affected_variation,public.issue.occurred_at,public.issue.received_at,public.issue.resolved_at,public.issue.created_at,public.issue.updated_at",
    "snapshot.mode": "initial",
    "snapshot.locking.mode": "none",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "false",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.unwrap.add.fields": "op,ts_ms",
    "transforms.unwrap.add.fields.prefix": "",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "aurora-productops-m2-1\\.public\\.(.+)",
    "transforms.route.replacement": "cdc.aurora.$1",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter.schemas.enable": "false",
    "time.precision.mode": "connect",
    "decimal.handling.mode": "double",
    "heartbeat.interval.ms": "10000",
    "heartbeat.topics.prefix": "__debezium-heartbeat",
    "errors.tolerance": "none",
    "errors.log.enable": "true"
  }
}
